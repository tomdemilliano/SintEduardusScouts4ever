rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /entries/{entryId} {
      // Iedereen mag gepubliceerde entries lezen (individueel of via lijst-query
      // met where('status','==','published')).
      allow read: if resource.data.status == 'published';

      // Schrijven (aanmaken, bewerken, publiceren, verwijderen) enkel voor
      // ingelogde beheerders. Zie README voor het instellen van een
      // beheerder-account via Firebase Auth.
      allow read, write: if request.auth != null;

      // Publiek aanmeldformulier (/toevoegen): niet-ingelogde bezoekers mogen
      // een NIEUWE entry aanmaken, maar altijd als concept, zonder scan, en
      // met beperkte veldgroottes — de beheerder moet dit nog goedkeuren
      // via /beheer voor het zichtbaar wordt. Geen read, update of delete.
      allow create: if request.auth == null
        && request.resource.data.status == 'draft'
        && request.resource.data.scanUrl == null
        && request.resource.data.scanPath == null
        && request.resource.data.naam is string
        && request.resource.data.naam.size() < 200
        && request.resource.data.geboortejaar.size() < 20
        && request.resource.data.totemnaam.size() < 100
        && request.resource.data.periode.size() < 100
        && request.resource.data.leuksteActiviteit.size() < 500
        && request.resource.data.besteKampplaats.size() < 10
        && request.resource.data.lekkersteEten.size() < 10;
    }

    match /locations/{locationId} {
      // Coördinaten van kampplaatsen mogen publiek gelezen worden (voor de kaart).
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /extraLocations/{locationId} {
      // Gepubliceerde extra kampplaatsen zijn publiek leesbaar; beheerders
      // zien alles (ook 'pending', voor goedkeuring).
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null;

      // Publiek voorstel (/kampplaats-toevoegen): niet-ingelogde bezoekers
      // mogen een NIEUWE locatie aanmaken, maar altijd als 'pending' — de
      // beheerder moet dit nog goedkeuren voor het publiek zichtbaar wordt.
      // Coördinaten mogen wel meegestuurd worden (bezoeker kiest zelf op
      // de kaart), maar zijn niet verplicht.
      allow create: if request.auth == null
        && request.resource.data.status == 'pending'
        && request.resource.data.naam is string
        && request.resource.data.naam.size() > 0
        && request.resource.data.naam.size() < 200
        && request.resource.data.beschrijving is string
        && request.resource.data.beschrijving.size() < 1000
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() < 200;
    }

    match /dishes/{dishId} {
      // Receptkoppelingen mogen publiek gelezen worden (voor de klikbare gerechten).
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /links/{linkId} {
      // De links-pagina is publiek leesbaar, enkel beheerders voegen toe/wijzigen.
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /badges/{badgeId} {
      // Jaarkentekens zijn publiek leesbaar (tijdlijn), enkel beheerders schrijven.
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /milestones/{milestoneId} {
      // Gepubliceerde mijlpalen zijn publiek leesbaar; beheerders zien alles
      // (ook 'pending', voor goedkeuring).
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null;

      // Publiek mijlpaal-voorstel (/mijlpaal-toevoegen): niet-ingelogde
      // bezoekers mogen een NIEUWE mijlpaal aanmaken, maar altijd als
      // 'pending', zonder afbeelding, en met beperkte veldgroottes — de
      // beheerder moet dit nog goedkeuren voor het publiek zichtbaar wordt.
      allow create: if request.auth == null
        && request.resource.data.status == 'pending'
        && request.resource.data.afbeeldingUrl == null
        && request.resource.data.afbeeldingPath == null
        && request.resource.data.jaar is int
        && request.resource.data.jaar > 1900
        && request.resource.data.jaar < 2200
        && request.resource.data.type in ['scouting', 'groep']
        && request.resource.data.titel is string
        && request.resource.data.titel.size() < 200
        && request.resource.data.beschrijving is string
        && request.resource.data.beschrijving.size() < 1000
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() < 200;
    }

    match /scoutTakken/{takId} {
      // Lijst van takken/groepen is publiek leesbaar (tijdlijn + selectie
      // bij het beheer van leidingsploegen); enkel de beheerder wijzigt ze.
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /leidingsploegen/{leidingId} {
      // Volledig crowdsourced: iedereen mag een leidingsploeg voor een
      // tak+werkingsjaar toevoegen of corrigeren, zonder in te loggen —
      // veel van deze historiek is verloren gegaan en kan enkel
      // gezamenlijk terug opgebouwd worden. Foutieve gegevens verbeter je
      // door de juiste namen opnieuw op te slaan; effectief verwijderen
      // van een document blijft wel beheerder-only.
      allow read: if true;
      allow create, update: if request.resource.data.takId is string
        && request.resource.data.werkingsjaarStart is int
        && request.resource.data.werkingsjaarStart > 1900
        && request.resource.data.werkingsjaarStart < 2200
        && request.resource.data.leden is list
        && request.resource.data.leden.size() < 30;
      allow delete: if request.auth != null;
    }

    match /photoTags/{tagId} {
      // De lijst van mogelijke foto-tags is publiek leesbaar (nodig voor de
      // filter en het toekennen van tags); enkel de beheerder maakt/wijzigt/
      // verwijdert een categorie, om wildgroei te vermijden.
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /photos/{photoId} {
      // Gepubliceerde foto's zijn publiek leesbaar; beheerders zien alles
      // (ook 'pending', voor goedkeuring).
      allow read: if resource.data.status == 'published' || request.auth != null;

      // Beheerders mogen alles (toevoegen, volledig bewerken, verwijderen).
      allow write: if request.auth != null;

      // Publieke NIEUWE foto: altijd 'pending'. De afbeelding zelf wordt
      // eerst naar Storage geüpload (zie storage.rules), dit document
      // verwijst er enkel naar.
      allow create: if request.auth == null
        && request.resource.data.status == 'pending'
        && request.resource.data.afbeeldingUrl is string
        && request.resource.data.afbeeldingUrl.size() > 0
        && request.resource.data.afbeeldingUrl.size() < 500
        && request.resource.data.afbeeldingPath is string
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() < 200;

      // Publieke BEWERKING van een reeds gepubliceerde foto: enkel de tags
      // (jaar, locatie, ledenTags) en het verwijderverzoek mogen wijzigen —
      // de afbeelding zelf, status en contactEmail moeten identiek blijven.
      // Dit is de crowdsourced tag-functie, bewust zonder goedkeuringsstap.
      allow update: if request.auth == null
        && resource.data.status == 'published'
        && request.resource.data.status == 'published'
        // De afbeelding zelf mag vervangen worden (bv. na het draaien),
        // maar enkel door een nieuw bestand onder het foto-pad in Storage
        // -- geen willekeurige externe URL.
        && request.resource.data.afbeeldingUrl is string
        && request.resource.data.afbeeldingUrl.size() < 500
        && request.resource.data.afbeeldingPath is string
        && request.resource.data.afbeeldingPath.matches('vriendenboekje/fotos/.*')
        && request.resource.data.contactEmail == resource.data.contactEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.jaar == null || request.resource.data.jaar is int)
        && request.resource.data.locatie is string
        && request.resource.data.locatie.size() < 200
        && request.resource.data.beschrijving is string
        && request.resource.data.beschrijving.size() < 500
        && request.resource.data.ledenTags is list
        && request.resource.data.ledenTags.size() < 30
        && request.resource.data.taggedEntryIds is list
        && request.resource.data.taggedEntryIds.size() < 30
        && request.resource.data.tagIds is list
        && request.resource.data.tagIds.size() < 20
        && request.resource.data.verwijderReden is string
        && request.resource.data.verwijderReden.size() < 300;
    }
  }
}
