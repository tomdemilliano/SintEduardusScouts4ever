rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /entries/{entryId} {
      // Iedereen mag gepubliceerde entries lezen (individueel of via lijst-query
      // met where('status','==','published')).
      allow read: if resource.data.status == 'published';

      // Schrijven (aanmaken, bewerken, publiceren, verwijderen) enkel voor
      // ingelogde beheerders. Zie README voor het instellen van een
      // beheerder-account via Firebase Auth.
      allow read, write: if request.auth != null;

      // Publiek aanmeldformulier (/toevoegen): niet-ingelogde bezoekers mogen
      // een NIEUWE entry aanmaken, maar altijd als concept, zonder scan, en
      // met beperkte veldgroottes — de beheerder moet dit nog goedkeuren
      // via /beheer voor het zichtbaar wordt. Geen read, update of delete.
      allow create: if request.auth == null
        && request.resource.data.status == 'draft'
        && request.resource.data.scanUrl == null
        && request.resource.data.scanPath == null
        && request.resource.data.naam is string
        && request.resource.data.naam.size() < 200
        && request.resource.data.geboortejaar.size() < 20
        && request.resource.data.totemnaam.size() < 100
        && request.resource.data.periode.size() < 100
        && request.resource.data.leuksteActiviteit.size() < 500
        && request.resource.data.besteKampplaats.size() < 10
        && request.resource.data.lekkersteEten.size() < 10;
    }

    match /locations/{locationId} {
      // Coördinaten van kampplaatsen mogen publiek gelezen worden (voor de kaart).
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /extraLocations/{locationId} {
      // Gepubliceerde extra kampplaatsen zijn publiek leesbaar; beheerders
      // zien alles (ook 'pending', voor goedkeuring).
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null;

      // Publiek voorstel (/kampplaats-toevoegen): niet-ingelogde bezoekers
      // mogen een NIEUWE locatie aanmaken, maar altijd als 'pending' — de
      // beheerder moet dit nog goedkeuren voor het publiek zichtbaar wordt.
      // Coördinaten mogen wel meegestuurd worden (bezoeker kiest zelf op
      // de kaart), maar zijn niet verplicht.
      allow create: if request.auth == null
        && request.resource.data.status == 'pending'
        && request.resource.data.naam is string
        && request.resource.data.naam.size() > 0
        && request.resource.data.naam.size() < 200
        && request.resource.data.beschrijving is string
        && request.resource.data.beschrijving.size() < 1000
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() < 200;
    }

    match /dishes/{dishId} {
      // Receptkoppelingen mogen publiek gelezen worden (voor de klikbare gerechten).
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /links/{linkId} {
      // De links-pagina is publiek leesbaar, enkel beheerders voegen toe/wijzigen.
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /badges/{badgeId} {
      // Jaarkentekens zijn publiek leesbaar (tijdlijn), enkel beheerders schrijven.
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /milestones/{milestoneId} {
      // Gepubliceerde mijlpalen zijn publiek leesbaar; beheerders zien alles
      // (ook 'pending', voor goedkeuring).
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null;

      // Publiek mijlpaal-voorstel (/mijlpaal-toevoegen): niet-ingelogde
      // bezoekers mogen een NIEUWE mijlpaal aanmaken, maar altijd als
      // 'pending', zonder afbeelding, en met beperkte veldgroottes — de
      // beheerder moet dit nog goedkeuren voor het publiek zichtbaar wordt.
      allow create: if request.auth == null
        && request.resource.data.status == 'pending'
        && request.resource.data.afbeeldingUrl == null
        && request.resource.data.afbeeldingPath == null
        && request.resource.data.jaar is int
        && request.resource.data.jaar > 1900
        && request.resource.data.jaar < 2200
        && request.resource.data.type in ['scouting', 'groep']
        && request.resource.data.titel is string
        && request.resource.data.titel.size() < 200
        && request.resource.data.beschrijving is string
        && request.resource.data.beschrijving.size() < 1000
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() < 200;
    }
  }
}
