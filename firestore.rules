rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /entries/{entryId} {
      // Iedereen mag gepubliceerde entries lezen (individueel of via lijst-query
      // met where('status','==','published')).
      allow read: if resource.data.status == 'published';

      // Schrijven (aanmaken, bewerken, publiceren, verwijderen) enkel voor
      // ingelogde beheerders. Zie README voor het instellen van een
      // beheerder-account via Firebase Auth.
      allow read, write: if request.auth != null;

      // Publiek aanmeldformulier (/toevoegen): niet-ingelogde bezoekers mogen
      // een NIEUWE entry aanmaken, maar altijd als concept, zonder scan, en
      // met beperkte veldgroottes — de beheerder moet dit nog goedkeuren
      // via /beheer voor het zichtbaar wordt. Geen read, update of delete.
      allow create: if request.auth == null
        && request.resource.data.status == 'draft'
        && request.resource.data.scanUrl == null
        && request.resource.data.scanPath == null
        && request.resource.data.naam is string
        && request.resource.data.naam.size() < 200
        && request.resource.data.geboortejaar.size() < 20
        && request.resource.data.totemnaam.size() < 100
        && request.resource.data.periode.size() < 100
        && request.resource.data.leuksteActiviteit.size() < 500
        && request.resource.data.besteKampplaats.size() < 10
        && request.resource.data.lekkersteEten.size() < 10;
    }

    match /locations/{locationId} {
      // Coördinaten van kampplaatsen mogen publiek gelezen worden (voor de kaart).
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /dishes/{dishId} {
      // Receptkoppelingen mogen publiek gelezen worden (voor de klikbare gerechten).
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /links/{linkId} {
      // De links-pagina is publiek leesbaar, enkel beheerders voegen toe/wijzigen.
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
